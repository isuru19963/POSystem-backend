# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=po_system

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3 (PO/GRN attachments). Production EB uses the instance IAM role when
# keys are omitted. Set USE_LOCAL_FILE_STORAGE=true for dev without S3.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=po-system-files
USE_LOCAL_FILE_STORAGE=

# Email (IMAP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_GROUP_ID=
# Approved utility templates (Twilio Content SID, e.g. HX...). See Admin → WhatsApp Templates.
TWILIO_WHATSAPP_TEMPLATE_OUTSIDE_SESSION=
TWILIO_WHATSAPP_TEMPLATE_NEW_PO=
TWILIO_WHATSAPP_TEMPLATE_DAILY_ORDERS=
TWILIO_WHATSAPP_TEMPLATE_DELIVERY_REPORT=
# Scheduled digests/reports use templates first (true) or free-form first (false)
TWILIO_WHATSAPP_PREFER_TEMPLATE_FOR_SCHEDULED=true
TWILIO_WHATSAPP_WEBHOOK_URL=https://your-api.example.com/api/v1/whatsapp/webhook/incoming

# JWT
JWT_SECRET=
JWT_EXPIRATION=1d

# NECC
NECC_API_URL=https://www.e2necc.com
